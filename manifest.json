{
  "manifest_version": 3,
  "name": "Per-Tab Volume Control",
  "version": "1.0.0",
  "description": "Control audio volume individually per browser tab using real Web Audio routing.",

  "permissions": [
    "tabs",
    "tabCapture",
    "storage",
    "offscreen"
  ],

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Per-Tab Volume Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
